{
  "name": "ai-world-cup-predictor",
  "description": "Interactive dashboard comparing AI model predictions for the 2026 FIFA World Cup",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Victor Busque",
  "repository": {
    "type": "git",
    "url": "https://github.com/VictorBusque/ai-world-cup.git"
  },
  "homepage": "https://github.com/VictorBusque/ai-world-cup#readme",
  "keywords": ["world-cup", "fifa", "ai", "predictions", "leaderboard", "react", "typescript"],
  "type": "module",
  "scripts": {
    "dev": "bun run --hot server.ts",
    "build": "vite build && bun build server.ts --outdir dist --target=bun --sourcemap",
    "build:static": "vite build",
    "start": "bun run dist/server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "predict": "bun run scripts/predict.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
